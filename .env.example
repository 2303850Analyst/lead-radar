# Необязательно: оставьте пустым для работы на встроенных демоданных.
# Укажите серверный ключ официального API Поиска по организациям Яндекс Карт.
# Никогда не добавляйте реальный ключ в Git.
YANDEX_MAPS_API_KEY=

# Не включайте live UI до письменного подтверждения допустимого сценария
# хранения, сортировки, обогащения и экспорта данных Яндексом.
YANDEX_LIVE_UI_ENABLED=false

# Базовый URL нужен только для абсолютных ссылок в metadata/OG.
SITE_URL=http://localhost:3000

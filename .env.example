# Geoapify добавлен в 0.2.0 и остаётся единственным live-провайдером alpha.
# Ключ должен быть только серверным:
# не используйте префикс NEXT_PUBLIC_ и не добавляйте реальное значение в Git.
GEOAPIFY_API_KEY=

# Бюджет одного поиска: максимум POI на категорийный batch и количество
# карточек, для которых запрашивается Place Details.
GEOAPIFY_PLACES_LIMIT=100
GEOAPIFY_DETAILS_LIMIT=20

# Активный источник поиска. Значение geoapify включает live-поиск при наличии
# GEOAPIFY_API_KEY; значение demo принудительно оставляет синтетические данные.
SEARCH_PROVIDER=geoapify

# Query Intelligence работает детерминированно по умолчанию. Для серверной
# Kimi-планирования переключите режим на kimi и задайте один из двух ключей.
# MOONSHOT_API_KEY имеет приоритет; значения никогда не публикуются в клиенте.
QUERY_INTELLIGENCE_MODE=deterministic
MOONSHOT_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_PLANNER_MODEL=kimi-k3
KIMI_PLANNER_REASONING_EFFORT=low
KIMI_REQUEST_TIMEOUT_MS=30000

# Local Tier-0 reliability profile: один активный Kimi-вызов, один ожидающий,
# pacing между стартами и общий deadline всего search request. Admission wait
# входит в общий deadline; не повышайте лимиты без проверки тарифа Moonshot.
KIMI_MIN_START_INTERVAL_MS=20000
KIMI_ADMISSION_TIMEOUT_MS=20000
KIMI_CIRCUIT_FAILURE_THRESHOLD=3
SEARCH_REQUEST_DEADLINE_MS=60000

# Optional post-search classifier пока имеет только безопасный adapter seam.
# Оставляйте false: true без отдельного разрешённого adapter пометит спорные
# карточки not_checked/degraded и не отправит их модели.
KIMI_LEAD_CLASSIFICATION_ENABLED=false
KIMI_LEAD_CLASSIFIER_TIMEOUT_MS=8000

# Случайная серверная строка не короче 32 байт для подписания одноразового по
# смыслу stateless-подтверждения. Не используйте NEXT_PUBLIC_ префикс.
SEARCH_PLAN_SIGNING_SECRET=

# Экспериментальный legacy-адаптер Яндекса оставлен выключенным. Не включайте
# его до письменного подтверждения допустимого сценария хранения и обработки.
YANDEX_MAPS_API_KEY=
YANDEX_LIVE_UI_ENABLED=false

# Базовый URL нужен только для абсолютных ссылок в metadata/OG.
SITE_URL=http://localhost:3000

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lead-radar.local/schemas/kimi-resolution.schema.json",
  "title": "LeadRadar Kimi category resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "selectedConceptIds",
    "alternatives",
    "confidenceBand",
    "clarificationReasonCode"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["selected", "ambiguous", "unsupported"]
    },
    "selectedConceptIds": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/conceptId" }
    },
    "alternatives": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conceptId", "reasonCodes"],
        "properties": {
          "conceptId": { "$ref": "#/definitions/conceptId" },
          "reasonCodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/reasonCode" }
          }
        }
      }
    },
    "confidenceBand": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "clarificationReasonCode": {
      "anyOf": [
        { "$ref": "#/definitions/reasonCode" },
        { "type": "null" }
      ]
    }
  },
  "definitions": {
    "conceptId": {
      "type": "string",
      "enum": [
        "logistics.fulfillment",
        "logistics.warehouse",
        "personal_care.barbershop",
        "personal_care.beauty_salon",
        "health.dentist",
        "health.medical_clinic",
        "health.pharmacy",
        "automotive.repair",
        "automotive.car_wash",
        "automotive.fuel_station",
        "automotive.charging_station",
        "retail.supermarket",
        "retail.convenience_store",
        "retail.bakery",
        "retail.butcher",
        "retail.florist",
        "retail.clothing",
        "retail.shoes",
        "retail.furniture",
        "retail.building_materials",
        "retail.electronics",
        "retail.pet_store",
        "food.restaurant",
        "food.cafe",
        "food.fast_food",
        "hospitality.hotel",
        "hospitality.hostel",
        "business.coworking",
        "business.real_estate_agency",
        "professional.law_firm",
        "professional.accounting",
        "technology.it_company",
        "marketing.advertising_agency",
        "services.cleaning",
        "services.laundry",
        "services.photography",
        "travel.travel_agency",
        "mobility.car_rental",
        "education.driving_school",
        "education.language_school"
      ]
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "EXACT_ALIAS",
        "FUZZY_MATCH",
        "SEMANTIC_MATCH",
        "AMBIGUOUS_SCOPE",
        "NEGATIVE_CONFLICT",
        "NO_SUPPORTED_CONCEPT",
        "PHYSICAL_PLACE_UNCLEAR",
        "LOCALE_UNCERTAIN",
        "KIMI_UNAVAILABLE",
        "KIMI_INVALID_RESPONSE",
        "KIMI_ADMISSION_TIMEOUT",
        "USER_CONFIRMED"
      ]
    }
  }
}
